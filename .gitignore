# ---------------------------------------------------------------------------
# KiCad
# ---------------------------------------------------------------------------
*-cache.lib
*-rescue.dcm
*-rescue.lib
fp-info-cache
*.kicad_sch-bak
*.kicad_pcb-bak
*.bak
*.lck
~*.kicad_*
.history/
hardware/WirelessBERA-backups/
hardware/.kicad-push

# Generated reports
*.rpt
*-erc.rpt
*-drc.rpt

# ---------------------------------------------------------------------------
# Vendor datasheets - large, and always re-downloadable from the manufacturer.
# Kept on disk under hardware/datasheets/ but deliberately out of the history.
# ---------------------------------------------------------------------------
hardware/datasheets/

# ---------------------------------------------------------------------------
# LTspice run output (the .asc sources and the stimulus data are tracked)
# ---------------------------------------------------------------------------
*.raw
*.op.raw
hardware/simulation/*.log

# ---------------------------------------------------------------------------
# ESP-IDF build output
# ---------------------------------------------------------------------------
firmware/*/build/
firmware/*/sdkconfig
firmware/*/sdkconfig.old
firmware/*/managed_components/
firmware/*/dependencies.lock

# ---------------------------------------------------------------------------
# kicad-happy - the hardware audit tool, cloned locally rather than vendored.
# See README.md; the working copy carries local modifications.
# ---------------------------------------------------------------------------
kicad-happy/

# ---------------------------------------------------------------------------
# Python / OS
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
*.tmp
*.temp

# ---------------------------------------------------------------------------
# Claude Code worktrees / local agent state
# ---------------------------------------------------------------------------
.claude/

# ---------------------------------------------------------------------------
# Measurements: per-figure analysis output is regenerated by the scripts in
# measurements/tools/ (analysis_*.py) and is large, so it stays out of git.
# ---------------------------------------------------------------------------
measurements/*/analysis/
